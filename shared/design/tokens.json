{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Questcademy Design Tokens",
  "version": "1.0.0",
  "colors": {
    "primary": {
      "default": "#4F46E5",
      "hover": "#6366F1",
      "deep": "#4338CA"
    },
    "accent": {
      "default": "#8B5CF6",
      "glow": "#A78BFA"
    },
    "semantic": {
      "success": "#10B981",
      "warning": "#F59E0B",
      "error": "#EF4444",
      "info": "#0EA5E9"
    },
    "neutral_dark": {
      "bg_canvas": "#0A0A0F",
      "bg_surface": "#0F0F18",
      "bg_elevated": "#14141F",
      "bg_hover": "#1A1A24",
      "bg_input": "#1F1F2E",
      "border_subtle": "#2A2A3A",
      "border_strong": "#3F3F52",
      "text_primary": "#F8FAFC",
      "text_secondary": "#CBD5E1",
      "text_muted": "#94A3B8",
      "text_disabled": "#64748B"
    },
    "subjects": {
      "math": "#4F46E5",
      "physics": "#8B5CF6",
      "chemistry": "#10B981",
      "biology": "#22C55E",
      "english": "#F59E0B",
      "cs": "#0EA5E9"
    }
  },
  "spacing": {
    "space_1": 4,
    "space_2": 8,
    "space_3": 12,
    "space_4": 16,
    "space_5": 20,
    "space_6": 24,
    "space_8": 32,
    "space_10": 40,
    "space_12": 48,
    "space_16": 64,
    "space_20": 80,
    "space_24": 96
  },
  "radii": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "full": 9999
  },
  "typography": {
    "font_family_ui": "Inter",
    "font_family_display": "Inter Display",
    "font_family_mono": "JetBrains Mono",
    "font_family_math": "KaTeX_Main",
    "scale": {
      "display_2xl": { "fontSize": 60, "lineHeight": 68, "fontWeight": 800 },
      "display_xl": { "fontSize": 48, "lineHeight": 56, "fontWeight": 800 },
      "display_lg": { "fontSize": 40, "lineHeight": 48, "fontWeight": 700 },
      "heading_xl": { "fontSize": 32, "lineHeight": 40, "fontWeight": 700 },
      "heading_lg": { "fontSize": 24, "lineHeight": 32, "fontWeight": 700 },
      "heading_md": { "fontSize": 20, "lineHeight": 28, "fontWeight": 600 },
      "heading_sm": { "fontSize": 18, "lineHeight": 26, "fontWeight": 600 },
      "body_lg": { "fontSize": 17, "lineHeight": 26, "fontWeight": 400 },
      "body_md": { "fontSize": 15, "lineHeight": 24, "fontWeight": 400 },
      "body_sm": { "fontSize": 13, "lineHeight": 20, "fontWeight": 400 },
      "label_md": { "fontSize": 14, "lineHeight": 20, "fontWeight": 500 },
      "label_sm": { "fontSize": 12, "lineHeight": 16, "fontWeight": 600 },
      "mono_md": { "fontSize": 14, "lineHeight": 22, "fontWeight": 400 }
    }
  }
}
