{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FrameworkMappingResponse",
  "type": "object",
  "required": ["proposals"],
  "properties": {
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["objective_id", "proposed_node", "confidence", "rationale"],
        "properties": {
          "objective_id": { "type": "string" },
          "proposed_node": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "rationale": { "type": "string" }
        }
      }
    }
  }
}
