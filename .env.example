# Copy to .env and fill in. Never commit .env. Values below are placeholders only.

# --- Backend ---
DATABASE_URL=sqlite:///./questcademy.db
REDIS_URL=redis://localhost:6379/1
GEMINI_API_KEY=
# Shared Gemini rate limiter: must be fail-closed outside tests (docs/decisions DD-08-3)
TESTING=false
FAIL_CLOSED=true
# Engine sidecar (defaults work from the repo root)
NODE_BIN=node
ENGINE_BRIDGE_CLI=

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Supabase ---
SUPABASE_PROJECT_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_CALLBACK_URL=
SUPABASE_JWKS_URL=
SUPABASE_DIREC_CONNECTION_STRING=

# --- Email ---
RESEND_API_KEY=

# --- Object storage (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
