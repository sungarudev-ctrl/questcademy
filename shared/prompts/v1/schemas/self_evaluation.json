{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SelfEvaluationResponse",
  "type": "object",
  "required": [
    "overall_score",
    "pedagogical_clarity",
    "mathematical_correctness",
    "diagnostic_depth",
    "critique",
    "pass"
  ],
  "properties": {
    "overall_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "pedagogical_clarity": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "mathematical_correctness": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "diagnostic_depth": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "critique": { "type": "string" },
    "pass": { "type": "boolean" }
  }
}
